{
  "name": "app-mute",
  "title": "App Mute",
  "description": "Mute individual macOS applications from Raycast",
  "icon": "icon.png",
  "author": "kr3t3n",
  "license": "MIT",
  "categories": ["System"],
  "platforms": ["macOS"],
  "version": "0.1.0",
  "scripts": {
    "dev": "ray develop",
    "build": "ray build",
    "lint": "ray lint",
    "test": "vitest run",
    "agent:test": "cd helper && swift test",
    "agent:build": "./helper/scripts/install.sh",
    "agent:stop": "./helper/scripts/stop.sh",
    "agent:diagnose": "./helper/scripts/diagnose.sh"
  },
  "dependencies": {
    "@raycast/api": "^1.96.0",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "commands": [
    {
      "name": "mute-app",
      "title": "Mute App",
      "description": "Mute one running app",
      "mode": "view",
      "arguments": [
        {
          "name": "appQuery",
          "type": "text",
          "placeholder": "App name",
          "required": false
        }
      ]
    },
    {
      "name": "unmute-app",
      "title": "Unmute App",
      "description": "Unmute one app",
      "mode": "view",
      "arguments": [
        {
          "name": "appQuery",
          "type": "text",
          "placeholder": "App name",
          "required": false
        }
      ]
    },
    {
      "name": "toggle-app-mute",
      "title": "Toggle App Mute",
      "description": "Toggle mute for one app",
      "mode": "view",
      "arguments": [
        {
          "name": "appQuery",
          "type": "text",
          "placeholder": "App name",
          "required": false
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "candidateApps",
      "type": "dropdown",
      "title": "Candidate Apps",
      "description": "Choose which apps appear in the mute list.",
      "required": false,
      "default": "running",
      "data": [
        {
          "title": "Running Apps",
          "value": "running"
        },
        {
          "title": "Running and Installed Apps",
          "value": "all"
        }
      ]
    },
    {
      "name": "includeBackgroundApps",
      "type": "checkbox",
      "title": "Include Background Apps",
      "label": "Include background apps",
      "description": "Show background apps that have no normal window.",
      "required": false,
      "default": false
    },
    {
      "name": "closeAfterAction",
      "type": "checkbox",
      "title": "Close After Action",
      "label": "Close Raycast after a successful action",
      "description": "Close the Raycast window after mute, unmute, or toggle succeeds.",
      "required": false,
      "default": true
    }
  ]
}
