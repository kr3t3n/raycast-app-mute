{
  "name": "app-mute",
  "version": "0.1.0",
  "description": "Mute individual macOS applications from Raycast",
  "scripts": {
    "dev": "raycast develop",
    "build": "raycast build",
    "lint": "raycast lint",
    "test": "vitest run",
    "agent:test": "cd helper && swift test",
    "agent:build": "./helper/scripts/install.sh"
  },
  "dependencies": {
    "@raycast/api": "^1.96.0",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "raycast": {
    "schemaVersion": 1,
    "title": "App Mute",
    "description": "Mute individual macOS apps",
    "icon": "icon.png",
    "author": "kr3t3n",
    "license": "MIT",
    "commands": [
      {
        "name": "mute-app",
        "title": "Mute App",
        "description": "Mute one running app",
        "mode": "view",
        "arguments": [
          {
            "name": "appQuery",
            "type": "text",
            "placeholder": "App name",
            "required": false
          }
        ]
      },
      {
        "name": "unmute-app",
        "title": "Unmute App",
        "description": "Unmute one app",
        "mode": "view",
        "arguments": [
          {
            "name": "appQuery",
            "type": "text",
            "placeholder": "App name",
            "required": false
          }
        ]
      },
      {
        "name": "toggle-app-mute",
        "title": "Toggle App Mute",
        "description": "Toggle mute for one app",
        "mode": "view",
        "arguments": [
          {
            "name": "appQuery",
            "type": "text",
            "placeholder": "App name",
            "required": false
          }
        ]
      }
    ],
    "preferences": [
      {
        "name": "candidateApps",
        "type": "dropdown",
        "title": "Candidate Apps",
        "default": "running",
        "data": [
          {
            "title": "Running Apps",
            "value": "running"
          },
          {
            "title": "Running and Installed Apps",
            "value": "all"
          }
        ]
      },
      {
        "name": "includeBackgroundApps",
        "type": "checkbox",
        "title": "Include Background Apps",
        "default": false
      },
      {
        "name": "closeAfterAction",
        "type": "checkbox",
        "title": "Close After Action",
        "default": true
      }
    ]
  }
}
